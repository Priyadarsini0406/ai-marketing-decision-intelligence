# ============================================================================
# Decision-Intel · frontend environment template (Supabase) — COMMIT ME
# ----------------------------------------------------------------------------
# Copy to .env and fill in values from your Supabase project:
#   Project Settings -> API -> Project URL / anon (public) key.
#
# SvelteKit convention: variables that may reach the browser MUST be prefixed
# PUBLIC_, and only the anon/public key may be used there. The service-role key
# must never appear in this file or any frontend code.
# ============================================================================
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-or-public-key>