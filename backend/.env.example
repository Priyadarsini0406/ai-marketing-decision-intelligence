# ============================================================================
# Decision-Intel · backend environment template (Supabase) — COMMIT ME
# ----------------------------------------------------------------------------
# Copy to .env and fill in values from your Supabase project:
#   Project Settings -> API -> Project URL / anon key / service_role key.
#
# SECURITY: SUPABASE_SERVICE_ROLE_KEY grants elevated privileges and BYPASSES
# Row Level Security. It must only ever be set on the server/backend. Never
# expose it to frontend/browser code.
# ============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>

# Optional: direct Supabase PostgreSQL connection string for FastAPI/SQLAlchemy
# (e.g. the pooler URL from Project Settings -> Database -> Connection string).
# Leave unset to keep the default local SQLite database for development.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres