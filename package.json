{
  "name": "decision-intel-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && ..\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "postinstall": "cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "test:admin": "cd frontend && npm run test:admin"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}